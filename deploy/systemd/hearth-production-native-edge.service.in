[Unit]
Description=Hearth production native private edge
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=hearth
Group=hearth
ExecStartPre=/usr/sbin/nginx -t -c /etc/hearth/production-native-edge.conf
ExecStart=/usr/sbin/nginx -c /etc/hearth/production-native-edge.conf -g 'daemon on; master_process on;'
ExecReload=/usr/sbin/nginx -c /etc/hearth/production-native-edge.conf -s reload
ExecStop=/usr/sbin/nginx -c /etc/hearth/production-native-edge.conf -s quit
Restart=on-failure
RestartSec=5s
MemoryMax=64M
PrivateTmp=true
ReadWritePaths=/data/hearth-native-production/edge

[Install]
WantedBy=multi-user.target
