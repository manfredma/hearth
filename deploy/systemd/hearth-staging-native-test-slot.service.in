[Unit]
Description=Hearth isolated staging integration/E2E test slot
After=network-online.target
Wants=network-online.target
Conflicts=hearth-staging-native-app.service
RequiresMountsFor=/data/hearth-native-staging/test-slot
ConditionPathExists=/run/hearth/staging-test-slot.env

[Service]
User=hearth
Group=hearth
WorkingDirectory=/opt/hearth-native/current
EnvironmentFile=/run/hearth/staging-test-slot.env
ExecStart=__JAVA_BIN__ -XX:MaxRAMPercentage=55 -jar /opt/hearth-native/current/app.jar
Restart=on-failure
RestartSec=5s
MemoryMax=384M
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/data/hearth-native-staging/test-slot
