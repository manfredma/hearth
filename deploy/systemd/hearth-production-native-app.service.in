[Unit]
Description=Hearth production native application
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data/hearth-native-production/data

[Service]
User=hearth
Group=hearth
WorkingDirectory=/opt/hearth-native/current
EnvironmentFile=/etc/hearth/production-native.env
ExecStart=__JAVA_BIN__ -XX:MaxRAMPercentage=65 -jar /opt/hearth-native/current/app.jar
Restart=on-failure
RestartSec=5s
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/data/hearth-native-production/data

[Install]
WantedBy=multi-user.target
