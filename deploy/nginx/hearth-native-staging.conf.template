server {
    listen 80;
    server_name staging-hearth.bytedepth.cn;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name staging-hearth.bytedepth.cn;
    ssl_certificate /etc/hearth/staging-tls/current/fullchain.pem;
    ssl_certificate_key /etc/hearth/staging-tls/current/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:18111;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
