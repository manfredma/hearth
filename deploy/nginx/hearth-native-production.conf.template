server {
    listen 80;
    server_name hearth.bytedepth.cn;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name hearth.bytedepth.cn;
    ssl_certificate /etc/letsencrypt/live/hearth.bytedepth.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hearth.bytedepth.cn/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:18113;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
