server {
    listen 80;
    server_name hearth.bytedepth.cn;
    location ^~ /.well-known/acme-challenge/ {
        root /data/hearth-native-production/acme-webroot;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name hearth.bytedepth.cn;
    ssl_certificate /data/hearth-native-production/letsencrypt/live/hearth.bytedepth.cn/fullchain.pem;
    ssl_certificate_key /data/hearth-native-production/letsencrypt/live/hearth.bytedepth.cn/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:18113;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
