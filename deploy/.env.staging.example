HEARTH_MYSQL_ROOT_PASSWORD=replace-with-a-staging-only-secret
HEARTH_REDIS_PASSWORD=replace-with-a-staging-only-secret
HEARTH_OIDC_ENABLED=true
HEARTH_OIDC_ISSUER_URI=https://identity.example.com
HEARTH_OIDC_CLIENT_ID=hearth-staging
HEARTH_OIDC_CLIENT_SECRET=inject-at-deploy-time
HEARTH_OIDC_POST_LOGOUT_REDIRECT_URI=https://staging-hearth.example.com/
HEARTH_APP_PORT=18083
