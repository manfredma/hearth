# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output
target/
*.class
*.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven Release Plugin transaction state. These files are regenerated locally;
# clean them with `mvn release:clean` and never commit them.
*.releaseBackup
release.properties

# Maven local settings (may contain credentials)
settings.xml
!.mvn/
!.mvn/settings.xml

# Machine-private deployment secrets. Keep the tracked *.example templates only.
.env

# IDE
.idea/
*.iml
*.ipr
*.iws

# OS
.DS_Store

# Tools
.worktrees/
.omc/
.omx/
.claude/
.gstack/
__pycache__/
.superpowers/

# Tool-generated analysis artifacts
.understand-anything/
.codegraph/

# Node.js / frontend tooling
node_modules/
coverage/
hearth-start/src/main/resources/static/

# Playwright 测试产物
test-results/
playwright-report/
